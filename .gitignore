implementation_plan.md

# Benchmark flow datasets (keep primary benchmarks tracked, ignore bulky captures)
datasets/*.csv
!datasets/UNSW_NB15_testing-set.csv
!datasets/kdd_test.csv
!datasets/ton-iot.csv

# Local IDE & editor configuration
.claude/
.vscode/
.idea/
*.swp
*.swo


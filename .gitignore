# Byte-compiled / optimized / ambient python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
.venv*/
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Testing, typing & coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Runtime logging & lockfiles
*.log
*.sqlite3
*.db

# Bulky experimental runs directory (raw outputs, large parquet logs, decision records)
/runs/
!runs/README.md
/data/
hdlnn/deploy/uploads/

# Phase Reports & Work Notes
PHASE*_REPORT.md
PRE_PHASE12_CLEANUP_REPORT.md
